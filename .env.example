DATABASE_URL="file:./dev.db"
JWT_SECRET="secret_for_local_dev"
ADMIN_INITIAL_PASSWORD="admin_password"

# Municípios permitidos para escaneamento.
# O sistema rejeitará automaticamente qualquer BU que não pertença a um destes códigos.
# Deixe vazio para permitir todos os municípios durante desenvolvimento.
# Exemplo (Código 1392 é referente à fixture oficial de Acrelandia/AC):
# COVERAGE_CITY_CODES=1392
COVERAGE_CITY_CODES=

# -------------------------------------------------------------------
# VARIÁVEIS EXCLUSIVAS DO BANCO OPERACIONAL (prisma/prod.db)
# NÃO use estas variáveis em desenvolvimento. NÃO versione com valores reais.
# Defina apenas na sessão PowerShell do operador antes de npm run db:setup:operacional
# -------------------------------------------------------------------
# $env:ADMIN_USERNAME="admin"
# $env:ADMIN_PASSWORD="senha-forte-aqui-minimo-10-chars"