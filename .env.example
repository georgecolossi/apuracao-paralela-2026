# ==============================================================================
# APURAÇÃO PARALELA 2026 (v2.0.0) — Variáveis de Ambiente de Exemplo
# Copie para `.env` em desenvolvimento local. NUNCA versione segredos reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados e Autenticação (Obrigatórios)
# ------------------------------------------------------------------------------
# Desenvolvimento local (SQLite relativo ao schema Prisma):
DATABASE_URL="file:./dev.db"
# Produção em volume persistente (exemplo Railway):
# DATABASE_URL="file:/data/prod.db"

# Obrigatório: chave secreta longa e aleatória (>= 32 caracteres).
# A aplicação falha fechada (`JWT_SECRET_NOT_CONFIGURED`) se não configurada.
JWT_SECRET="substitua-por-chave-aleatoria-local-com-pelo-menos-32-caracteres"

# ------------------------------------------------------------------------------
# 2. Domínio Público e Proteção CSRF
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Preenchido automaticamente no Railway ou configurado com o domínio HTTPS público:
# RAILWAY_PUBLIC_DOMAIN="seu-subdominio.up.railway.app"
# Defina "staging" apenas em ambientes de homologação para exibir faixa de aviso:
NEXT_PUBLIC_APP_ENV="development"
# Origens extras opcionais (separadas por vírgula) aceitas em `next dev` (ex.: túnel local/LAN):
# ALLOWED_DEV_ORIGINS="localhost,192.168.1.10"

# ------------------------------------------------------------------------------
# 3. Setup Inicial, Bootstrap Administrativo e Rate Limiting de Login
# ------------------------------------------------------------------------------
# Número de proxies reversos confiáveis à frente da aplicação para interpretar `X-Forwarded-For`
# da direita para a esquerda (por posição exata, sem filtrar itens inválidos) no rate limiting de `POST /api/login`.
# Use "0" (padrão seguro) quando não houver proxy reverso confiável: cabeçalhos são ignorados e o fallback
# aplica limite individual por conta (5 falhas bloqueiam temporariamente a conta mesmo entre origens distintas,
# eliminando bloqueio coletivo entre contas, porém sem impedir DoS direcionado a uma única conta específica).
# Em deploy atrás de proxy confiável (ex.: Railway ou Nginx direto), use "1" (ou "2+" com CDN/WAF à frente),
# somente após validar empiricamente o cabeçalho `X-Forwarded-For` real no ambiente de implantação.
LOGIN_TRUSTED_PROXY_HOPS="0"
# Parâmetros opcionais do rate limiter em memória de `POST /api/login` (padrões: 15 min, 5/par, 20/IP):
# LOGIN_RATE_LIMIT_WINDOW_MS="900000"
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_PAIR="5"
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP="20"

# Defina "true" após criar o primeiro administrador para bloquear /api/setup via HTTP:
DISABLE_HTTP_SETUP="false"
# Token opcional exigido para autorizar chamadas a POST /api/setup (quando configurado):
# ADMIN_SETUP_TOKEN="defina-um-token-seguro-de-setup"

# Credenciais opcionais para `npx prisma db seed` ou `node scripts/create-initial-admin.mjs`:
# INITIAL_ADMIN_EMAIL="admin@seudominio.org"
# INITIAL_ADMIN_PASSWORD="troque-por-senha-forte-min-10-chars"
# INITIAL_ADMIN_NAME="Administrador Inicial"

# ------------------------------------------------------------------------------
# 4. Flags Operacionais, Parser QRBU e Integração TSE
# ------------------------------------------------------------------------------
# Mantenha "false" em produção para bloquear resets destrutivos via /api/admin/reset:
ALLOW_OPERATIONAL_RESET="false"

# Mantenha "false" em produção para rejeitar BUs com FASE != "O" (simulados/treinamento):
ALLOW_SIMULATED_FASE="false"

# Mantenha "false" salvo necessidade de aceitar versões VRQR experimentais:
ALLOW_EXPERIMENTAL_VRQR="false"

# Timeout (ms) para requisições externas ao endpoint EA20 oficial do TSE (padrão: 5000):
TSE_FETCH_TIMEOUT_MS="5000"

# ------------------------------------------------------------------------------
# 5. Fallback Visual de Abrangência (quando ainda não houver escopo ativo)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CITY_NAME=""
# NEXT_PUBLIC_STATE_CODE=""
